# ═══════════════════════════════════════════════════════════════════
#  CuxtonAI — front-end environment
#
#  Copy to .env.local and fill in from your Supabase project settings
#  (Project Settings → API). Both values are shipped to the browser and
#  are public by design; Row Level Security is what protects the data.
#
#  Never put the service_role key here — it belongs only in the Edge
#  Function secrets (see supabase/README.md).
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Google Analytics 4 ────────────────────────────────────────────
#  Measurement ID from GA4 Admin → Data Streams → your web stream.
#  Leave blank to disable analytics entirely (no script, no banner).
#  Inlined at build time, so it must be set in the CI/host environment
#  too — not just locally.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
